<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Style.Card.Textile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="15dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="15dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivTextile"
                android:layout_width="293dp"
                android:layout_height="216dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_background" />

            <TextView
                android:id="@+id/tvTextileName"
                style="@style/Style.Text.Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Kain" />

            <TextView
                android:id="@+id/tvTextileType"
                style="@style/Style.Text.Type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kategori" />

            <TextView
                android:id="@+id/tvTextilePrice"
                style="@style/Style.Text.Price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Rp 0 / meter" />

            <TextView
                android:id="@+id/tvTextileStock"
                style="@style/Style.Text.Type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stok: 10"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_margin="15dp">

            <Button
                android:id="@+id/btnAdd"
                style="@style/Style.Button.AddBuy"
                android:layout_width="wrap_content"
                android:layout_height="55dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingVertical="4dp"
                android:text="+"
                android:textSize="28sp" />

            <Button
                android:id="@+id/btnDec"
                style="@style/Style.Button.AddBuy"
                android:layout_width="wrap_content"
                android:layout_height="55dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingVertical="4dp"
                android:text="-"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/tvItemCount"
                style="@style/Style.Text.Type"
                android:layout_width="41dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="0"
                android:textAlignment="center"
                android:visibility="gone" />

        </LinearLayout>


    </LinearLayout>
</androidx.cardview.widget.CardView>